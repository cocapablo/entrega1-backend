{{#if user}}
<div class="container my-5 " id="idProfileUsuario">
    <div class="card text-white bg-info mb-3" style="max-width: 80rem;">
        <div class="card-header fs-2">Your Profile</div>
        <div class="row g-0">
            {{#if user.profile}}
            <div class="col-md-4">
                <img src={{user.profile}} class="img-fluid rounded-start" alt="Imagen de Perfil del Usuario">
            </div>
            {{/if}}

            <div class="col-md-8">
                <div class="card-body">
                    <p class="card-text"><spam class="fw-bold">First Name:</spam> {{user.first_name}}</p>
                    <p class="card-text"><spam class="fw-bold">Last Name:</spam> {{user.last_name}}</p>
                    <p class="card-text"><spam class="fw-bold">EMail:</spam> {{user.email}}</p>
                    <p class="card-text"><spam class="fw-bold">Age:</spam> {{user.age}}</p>
                </div>
            </div>
        </div>
    </div>
</div>

{{!-- Formulario para Subir Documentación--}}

<form class="container my-5">
    <label class="form-control bg-warning text-black fw-bold" id="formError" style="display: none;"></label>
    
    <label class="form-control bg-primary text-white fw-bold">Seleccione los archivos a enviar</label>

    <label style="display:none;" id="formIdUsuario">{{user.id}}</label>   

    
    <div class="form-group row my-2">
        <label class="col-sm-2 col-form-label" for="formProfile">Foto de Perfil</label>
        <div class="col-sm-10">
            <input type="file" id="formProfile" class="form-control" name="profile" accept="image/*" value="" ></input>
        </div>
    </div>

    <div class="form-group row my-2">
        <label class="col-sm-2 col-form-label" for="formIdentificacion">Identificación</label>
        <div class="col-sm-10">
            <input type="file" id="formIdentificacion" class="form-control" name="identificacion" accept="image/*" value="" ></input>
        </div>
    </div>  

    <div class="form-group row my-2">
        <label class="col-sm-2 col-form-label" for="formDomicilio">Domicilio</label>
        <div class="col-sm-10">
            <input type="file" id="formDomicilio" class="form-control" name="domicilio" accept="application/pdf" value="" ></input>
        </div>
    </div>  

    <div class="form-group row my-2">
        <label class="col-sm-2 col-form-label" for="formEstadoDeCuenta">Estado de Cuenta</label>
        <div class="col-sm-10">
            <input type="file" id="formEstadoDeCuenta" class="form-control" name="estadodecuenta" accept="application/pdf" value="" ></input>
        </div>
    </div>  
    
</form>

<div class="container my-5">
    <button class="btn btn-primary m-4" id="btnEnviarDocumentos" onclick="agregarDocumentosDeForm()">Enviar Archivos</button>
  
</div>

{{/if}}



<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/profile.js"></script>